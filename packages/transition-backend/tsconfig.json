{
    "extends": "../../configs/base.tsconfig.json",
    "compilerOptions": {
        "outDir": "lib",
        "rootDir": "src",
        // Resolve the `exports` of ES module packages, like p-queue, which
        // Node loads with `require()`. The emitted code is still CommonJS.
        "module": "node20",
        "moduleResolution": "node16",
        "isolatedModules": false, // Should be removed to inherit the true eventually
        "noImplicitAny": false, // Should be removed to inherit the true eventually
    },
    "exclude": [
        "node_modules",
        "**/__tests__",
        "**/__mocks__",
        "**/*.test.ts"
    ],
    "include": [
        "src/**/*.ts"
    ]
}
